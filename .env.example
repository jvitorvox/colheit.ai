# Banco — papel DONO: roda migração e job, passa por cima da política de RLS
POSTGRES_DB=colheitai
POSTGRES_USER=colheitai_owner
POSTGRES_PASSWORD=troque-em-producao
POSTGRES_PORT=5433

# Banco — papel APLICAÇÃO: atende requisição e OBEDECE à política de RLS.
# Não é dono de nenhuma tabela. Sem essa separação, RLS é decoração.
APP_DB_USER=colheitai_app
APP_DB_PASSWORD=troque-em-producao

API_PORT=7011

# Segredo de assinatura dos tokens. Mínimo 32 caracteres; trocar em produção
# invalida todas as sessões, o que é o comportamento desejado num vazamento.
JWT_SEGREDO=desenvolvimento-apenas-troque-isto-em-producao-por-favor
AUTH_EXPOR_CODIGO=1

# Par VAPID do Web Push. Gere o seu com:
#   docker compose exec -w /app/api api node --input-type=module \
#     -e "import w from 'web-push'; console.log(w.generateVAPIDKeys())"
# Trocar invalida TODAS as assinaturas existentes — cada navegador teria de
# assinar de novo. Em produção, vem de secret.
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTATO=mailto:suporte@colheit.ai

# Segredo do gateway do WhatsApp. O adaptador (Baileys) se identifica com ele —
# não é usuário, não tem sessão. Mínimo 16 caracteres; sem isso a porta fica
# fechada, de propósito.
GATEWAY_SEGREDO=

# Armazém de mídia. `s3` fala com o MinIO do compose — é o caminho que produção
# usa, e por isso é o padrão também aqui. `disco` grava em MIDIA_DIR, para quem
# não quiser subir o contêiner.
ARMAZEM=s3
S3_BUCKET=colheitai-midia
S3_CHAVE=colheitai
S3_SEGREDO=troque-em-producao

# ---------------------------------------------------------------------------
# Leitura automática dos relatos de campo (transcrição + extração)
#
# ⚠️ NASCE DESLIGADA, e são DUAS chaves para ligar.
#
# `IA_PLANO=sem-treino` não tem efeito nenhum no código — é a declaração, por
# escrito e num arquivo que alguém revisa, de que o contrato com o provedor
# proíbe treinar no que sobe. O que sobe é a voz de um produtor descrevendo a
# própria lavoura. Com a chave e sem a declaração, o extrator continua
# desligado e o motivo aparece no log da subida.
#
# Enquanto estiver desligada nada se perde: o relato fica em
# `aguardando_extracao` e entra de uma vez com `npm run ler`.
IA_CHAVE=
IA_PLANO=
IA_MODELO=gemini-2.5-flash
IA_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Correio — recuperação de senha e autoatendimento de cadastro
#
# NASCE DESLIGADA, e a recuperação NÃO depende dela: sem isto aqui o gestor
# continua abrindo acesso pela aba Equipe, e `npm run admin -- senha <e-mail>`
# continua abrindo o do próprio gestor. Sem correio o que fica de fora é o
# autoatendimento: nem "esqueci minha senha", nem abrir a conta da empresa pela
# tela. Nos dois casos a tela diz isso, em vez de mandar a pessoa esperar um
# e-mail que não vem.
#
# APP_URL é obrigatório junto com o SMTP, e por segurança: sem ele a API teria
# de adivinhar o próprio endereço pelo cabeçalho `Host`, que quem faz a
# requisição escolhe — e um `Host` forjado mandaria para a caixa da vítima um
# link legítimo apontando para o servidor de outra pessoa.
#
# SMTP_DE tem de usar um domínio VERIFICADO no provedor. É de longe o erro mais
# comum, e ele não aparece na conexão: autentica, conecta, e o servidor recusa
# na hora de aceitar a mensagem. `npm run admin -- correio <e-mail>` diz em qual
# das duas etapas parou, que é o diagnóstico inteiro.
APP_URL=
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_DE=

# SMTP_HOST=registro imprime a mensagem no log em vez de mandar.
# ⚠️ DESENVOLVIMENTO. O link de confirmação e o de senha valem uma senha
# enquanto vivem, e nesse modo eles saem em texto puro no log do contêiner.
# Existe para dar para ver o autoatendimento funcionando antes de haver um
# servidor de e-mail — não para produção.
